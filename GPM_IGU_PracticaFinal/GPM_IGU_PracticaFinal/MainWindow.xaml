<Window x:Class="GPM_IGU_PracticaFinal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GPM_IGU_PracticaFinal"
        mc:Ignorable="d"
        Title="IGU Fitness Tracker" Height="550" Width="800" Icon="/Items/fitness_icon.png" WindowStartupLocation="CenterScreen" Background="#d8dfe6" Closed="Window_Closed">

    <DockPanel>
        <TabControl >
            <TabItem Name="Tab_Exercises" Background="#a8aeb3" Header="Ejercicios" >
                <Grid Background="#a8aeb3">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="Add_Ex_Button" Content="Ejercicios predeterminados" Background="#f0f8ff" Margin="10" BorderThickness="3" Grid.Row="1" Grid.Column="0" Height="25" VerticalAlignment="Bottom" ToolTipService.ToolTip="Mostrar preseleccion ejercicios" Click="Add_Examples_Button_Click"/>
                    <Button x:Name="Add_Button" Content="Añadir" Background="#f0f8ff" Margin="10" BorderThickness="3" Grid.Row="1" Grid.Column="1" Height="25" VerticalAlignment="Bottom" Click="Add_Button_Click"/>
                    <Button x:Name="Delete_Button" Content="Borrar" Background="#f0f8ff" Margin="10" BorderThickness="3" Grid.Row="1" Grid.Column="2" Height="25"  IsEnabled="False" VerticalAlignment="Bottom" Click="Delete_Button_Click"/>
                    <Button x:Name="Modify_Button" Content="Modificar" Background="#f0f8ff" Margin="10" BorderThickness="3" Grid.Row="1" Grid.Column="3" Height="25"  IsEnabled="False" VerticalAlignment="Bottom" Click="Modify_Button_Click"/>

                    <ListView x:Name="ExercisesTable" Margin="15" Grid.Row="0" Grid.ColumnSpan="5" SelectionChanged="ExercisesTable_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="NOMBRE" Width="120" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="DESCRIPCION" Width="460" DisplayMemberBinding="{Binding Description}"/>
                                <GridViewColumn Header="GRUPOS MUSCULARES" Width="180" DisplayMemberBinding="{Binding MuscleGroup}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
            <TabItem Name="Tab_Daily_Insight" Background="#a8aeb3" Header="Daily Insight" >
                <Grid Background="#a8aeb3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <DatePicker x:Name="DateSelector" Background="#f0f8ff" BorderThickness="3" Grid.Row="0" Grid.Column="1" Height="30" Width="200" SelectedDateChanged="DateSelector_SelectedDateChanged"/>

                    <Canvas x:Name="graphicCanvas" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Width="500" Height="410"   Background="#f0f8ff"/>
                    
                </Grid>
            </TabItem>
            <TabItem Name="AddExercise_Tab" Header="Formulario ejercicios" Visibility="Hidden">
                <Grid Background="#a8aeb3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label x:Name="LabelForm" Content="Formulario de ejercicios" FontSize="21" FontWeight="Black"  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                    <Label Content="Nombre:" FontSize="11" Grid.Row="1" Grid.Column="1" Margin="5,0,5,5" VerticalAlignment="Center" HorizontalContentAlignment="Left"/>
                    <TextBox x:Name="nameExercise_TextBox" FontSize="11" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Height="20" Width="200" HorizontalAlignment="Center"/>

                    <Label Content="Descripcion:" FontSize="11" Grid.Row="2" Grid.Column="1" Margin="5,0,5,5" VerticalAlignment="Center" HorizontalContentAlignment="Left"/>
                    <TextBox x:Name="descriptionExercise_TextBox" FontSize="11" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Height="20" Width="200" HorizontalAlignment="Center" />

                    <Label Content="Grupo muscular:" FontSize="11" Grid.Row="3" Grid.Column="1" Margin="5,0,5,5" VerticalAlignment="Center" HorizontalContentAlignment="Left"/>
                    <ComboBox x:Name="MuscleNameComboBox" Grid.Row="3" FontSize="11" Grid.Column="2" Grid.ColumnSpan="2" Height="20" Width="200" HorizontalAlignment="Center" SelectionChanged="MuscleNameComboBox_SelectionChanged" >
                        <ComboBoxItem>Core</ComboBoxItem>
                        <ComboBoxItem>Brazos</ComboBoxItem>
                        <ComboBoxItem>Pecho</ComboBoxItem>
                        <ComboBoxItem>Espalda</ComboBoxItem>
                        <ComboBoxItem>Piernas</ComboBoxItem>
                    </ComboBox>

                    <Button x:Name="ConfirmNewEx_Button" Content="Aceptar" Background="#b2f49f" Margin="10"  Grid.Row="4" BorderBrush="DarkSeaGreen"  Grid.Column="1" Height="25" VerticalAlignment="Bottom" Click="ConfirmNewEx_Button_Click" IsEnabled="False"/>
                    <Button x:Name="Cancel_Button" Content="Cancelar" Background="#f68779" Margin="10" Grid.Row="4" Grid.Column="3" Height="25" VerticalAlignment="Bottom" Click="Cancel_Button_Click"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
